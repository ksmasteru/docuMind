{
  "info": {
    "name": "PHOVA role accounts",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Creates one account per workshop role on the server. Fill adminEmail, adminPassword, accountPassword (and adminKey if you run 0a), then Run collection. All nine accounts get accountPassword."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "0a. Register admin (only if the server has no admin yet)",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register-admin",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"admin_key\": \"{{adminKey}}\",\n  \"name\": \"Admin\",\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('admin created', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "0b. Login as admin (saves the token)",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('logged in', () => pm.response.to.have.status(200));",
              "pm.test('is admin', () => pm.expect(pm.response.json().Role).to.eql('ADMIN'));",
              "pm.collectionVariables.set('token', pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "1. Create sales@phova.com (SALES)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register_manager",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Sales\",\n  \"email\": \"sales@phova.com\",\n  \"password\": \"{{accountPassword}}\",\n  \"role\": \"SALES\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('created', () => pm.response.to.have.status(200));",
              "pm.test('role is SALES', () => pm.expect(pm.response.json().users[0].role).to.eql('SALES'));"
            ]
          }
        }
      ]
    },
