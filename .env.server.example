# Copy to .env on the server (cp .env.server.example .env) and fill it in. git ignores .env.
# scripts/init-server.sh refuses to run while a required value is blank.

# --- secrets (required) ---
# base64 of 32 random bytes: openssl rand -base64 32
JWT_SECRET=
# lets POST /api/auth/register-admin create an admin; any long random string: openssl rand -hex 32
ADMIN_KEY=
OPENAI_API_KEY=

# --- database (required) ---
# application.properties connects to database "documind" as user "documind": keep both as they are
POSTGRES_DB=documind
POSTGRES_USER=documind
POSTGRES_PASSWORD=
# the backend's password for it: the same value as POSTGRES_PASSWORD
DB_PASSWORD=

# --- addresses ---
# the app's public address, e.g. https://1-2-3-4.sslip.io (required: CORS, and the QR codes below)
FRONT_END_URL=
# where the QR codes on report PDFs point; blank = FRONT_END_URL. A printed QR code keeps it forever.
VERIFY_BASE_URL=

# --- Grafana (port 3001, open to the internet): blank means admin/admin ---
GRAFANA_ADMIN_PASSWORD=

# --- optional: these defaults match docker-compose.server.yml ---
REDIS_HOST=redis
REDIS_PORT=6379
ANALYSIS_HOST=http://analysis-service:8001

# DB_HOST, DB_PORT, DB_NAME and DB_USER, found in older .env files, are read by nothing: leave them out.
